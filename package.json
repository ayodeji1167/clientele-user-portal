{
  "name": "clientelle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|json|ts|tsx)\"",
    "build": "yarn gen:theme-typings && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "gen:theme-typings": "chakra typegen ./src/theme/index.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-table": "^9.2.6",
    "apexcharts": "^7.8.0",
    "axios": "^1.20.0",
    "formik": "^2.4.9",
    "moment": "^2.31.0",
    "react": "^19.2.8",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.23.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.37.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
